{
  "name": "pricefeed",
  "version": "0.0.0",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf artifacts cache typechain-types coverage",
    "compile": "bunx hardhat compile",
    "lint": "bun run lint:ts && bun run lint:sol",
    "lint:sol": "solhint 'contracts/**/*.sol' --ignore-path .solhintignore --noPoster",
    "lint:sol:fix": "solhint 'contracts/**/*.sol' --fix --ignore-path .solhintignore --noPrompt --noPoster",
    "lint:ts": "bunx biome check .",
    "lint:ts:fix": "bunx biome check --write .",
    "test": "bunx hardhat test",
    "test:coverage": "COVERAGE=true hardhat coverage",
    "test:gas": "REPORT_GAS=true hardhat test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@biomejs/biome": "^2.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@types/node": "^24.1.0",
    "hardhat": "^2.26.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "rimraf": "^6.0.1",
    "solhint": "^6.0.0",
    "valibot": "^1.1.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "@openzeppelin/contracts-upgradeable": "^5.4.0",
    "@seda-protocol/evm": "^1.0.0"
  }
}
