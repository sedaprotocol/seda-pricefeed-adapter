{
  "name": "seda-pricefeed-adapter",
  "version": "0.0.0",
  "description": "Price Feed Adapter for the SEDA Protocol FAST oracle path (SedaPythAdapter + FastProver).",
  "keywords": [
    "seda",
    "pyth",
    "oracle",
    "price-feed",
    "solidity",
    "evm",
    "ethereum",
    "uups"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sedaprotocol/seda-pricefeed-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/sedaprotocol/seda-pricefeed-adapter/issues"
  },
  "homepage": "https://github.com/sedaprotocol/seda-pricefeed-adapter#readme",
  "author": "Open Oracle Association, Switzerland",
  "license": "MIT",
  "scripts": {
    "check": "bun run check:sol && bun run check:ts",
    "check:sol": "solhint 'contracts/**/*.sol' --noPoster && prettier --check \"**/*.sol\"",
    "check:ts": "biome check .",
    "clean": "hardhat clean && rimraf cache coverage",
    "compile": "hardhat compile",
    "fix": "bun run fix:sol && bun run fix:ts",
    "fix:sol": "solhint --fix 'contracts/**/*.sol' --noPrompt --noPoster && prettier --write \"**/*.sol\"",
    "fix:ts": "biome check --write --unsafe .",
    "size": "hardhat size-contracts",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "test:gas": "REPORT_GAS=true hardhat test"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "dotenv": "^17.4.2",
    "hardhat": "^2.28.6",
    "hardhat-contract-sizer": "^2.10.1",
    "prettier": "^3.8.3",
    "prettier-plugin-solidity": "^2.3.1",
    "rimraf": "^6.1.3",
    "solhint": "^6.2.1"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1"
  },
  "files": [
    "/artifacts/contracts/**/*.json",
    "!/artifacts/contracts/**/*.dbg.json",
    "!/artifacts/contracts/test/**/*",
    "/contracts/**/*.sol",
    "!/contracts/test/**/*",
    "/typechain-types/**/*.d.ts",
    "/typechain-types/**/*.ts",
    "!/typechain-types/contracts/test/**/*",
    "!/typechain-types/factories/contracts/test/**/*"
  ]
}
