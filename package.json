{
  "name": "seda-pricefeed-adapter",
  "version": "0.0.0",
  "scripts": {
    "check": "bun run lint && bun run format:sol",
    "clean": "bunx hardhat clean && rimraf cache coverage",
    "compile": "bunx hardhat compile",
    "format:sol": "prettier --check \"**/*.sol\"",
    "format:sol:fix": "prettier --write \"**/*.sol\"",
    "lint": "bun run lint:ts && bun run lint:sol",
    "lint:sol": "solhint 'contracts/**/*.sol' --ignore-path .solhintignore --noPoster",
    "lint:sol:fix": "solhint 'contracts/**/*.sol' --fix --ignore-path .solhintignore --noPrompt --noPoster",
    "lint:ts": "bunx biome check .",
    "lint:ts:fix": "bunx biome check --write --unsafe .",
    "test": "bunx hardhat test",
    "test:coverage": "bunx hardhat coverage",
    "test:gas": "REPORT_GAS=true bunx hardhat test",
    "size": "bunx hardhat size-contracts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "",
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "dotenv": "^17.3.1",
    "hardhat": "^2.26.3",
    "hardhat-contract-sizer": "^2.10.0",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^2.1.0",
    "rimraf": "^6.0.1",
    "solhint": "^6.0.1"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "@openzeppelin/contracts-upgradeable": "^5.4.0"
  },
  "files": [
    "/artifacts/contracts/**/*.json",
    "!/artifacts/contracts/**/*.dbg.json",
    "!/artifacts/contracts/test/**/*",
    "/contracts/**/*.sol",
    "!/contracts/test/**/*",
    "/typechain-types/**/*.d.ts",
    "/typechain-types/**/*.ts",
    "!/typechain-types/contracts/test/**/*",
    "!/typechain-types/factories/contracts/test/**/*"
  ]
}
