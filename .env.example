# Copy this file to .env and fill in real values for non-local deployments.
# `.env` is gitignored; never commit secrets.

# --- RPC ---------------------------------------------------------------------
# Override per-environment. Local default (anvil) shown; production should
# point at a real provider (Infura, Alchemy, Tenderly, your own node, etc.).
RPC_URL=http://127.0.0.1:8545

# --- Signing -----------------------------------------------------------------
# For local anvil only: a well-known dev key, no real funds.
# For ANY non-local network: leave PRIVATE_KEY empty and set ACCOUNT instead
# (see "Encrypted keystore" below). Never commit a real private key.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Encrypted keystore (recommended for testnet/mainnet).
# Setup once:
#   cast wallet import deployer --interactive
# Then set ACCOUNT to that name. When set, every `just` recipe ignores
# PRIVATE_KEY and uses `--account $ACCOUNT`, prompting for the keystore
# password at run time.
# ACCOUNT=deployer

# Address that owns the deployed proxies (UUPS upgrade authority).
# Local default = anvil account 0. For ACCOUNT-based flows, set this to the
# address of the imported keystore.
OWNER=0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266

# --- Optional: deploy-time config -------------------------------------------
# Comma-separated trusted signer keys to seed on the FastProver after deploy.
# TRUSTED_KEYS=0xabc...,0xdef...

# --- Optional: verification --------------------------------------------------
# Required if you pass `--verify` to `forge script` against a public network.
# ETHERSCAN_API_KEY=
